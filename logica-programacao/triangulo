algoritmo "triangulo"

var
   L1, L2, L3: real
   TRI, EQ, ES: logico

inicio

   escreval("Digite o primeiro lado:")
   leia(L1)

   escreval("Digite o segundo lado:")
   leia(L2)

   escreval("Digite o terceiro lado:")
   leia(L3)

   TRI <- (L1 < L2 + L3) e (L2 < L1 + L3) e (L3 < L1 + L2)

   EQ <- TRI e (L1 = L2) e (L2 = L3)

   ES <- TRI e (L1 <> L2) e (L2 <> L3) e (L1 <> L3)

   escreval("")
   escreval("===== RESULTADO =====")
   escreval("Pode formar um triangulo? ", TRI)
   escreval("E equilatero? ", EQ)
   escreval("E escaleno? ", ES)

fimalgoritmo